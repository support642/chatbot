# Copy to .env and fill in. NEVER commit .env.
PORT=4001

# PostgreSQL (same AWS RDS database as the main backend)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# OpenAI
# The key is normally set by a super admin in the app (Settings -> AI tab) and stored
# ENCRYPTED in the database. OPENAI_API_KEY here is only an optional fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# REQUIRED to save the OpenAI key from the app. Min 32 chars, keep it secret and back it up:
# if it is lost or changed, the stored key can no longer be decrypted and must be re-entered.
# Generate with:  openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Comma separated browser origins allowed to call this service
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to false ONLY for a local non-SSL Postgres (default: SSL on, needed for AWS RDS)
# DB_SSL=true
